# Firebase Configuration for Real SMS OTP Authentication
# To enable real SMS delivery to Indian (+91) phone numbers:
# 1. Create a free project at https://console.firebase.google.com/
# 2. Go to Authentication -> Sign-in method -> Enable 'Phone' provider.
# 3. Copy project credentials from Project Settings into your .env file below.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
